{
  "name": "@regenic/connector-github-copilot",
  "version": "0.1.0",
  "description": "Regenic connector for GitHub Copilot CLI SDK task sessions",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "regenic": {
    "plugin": true,
    "catalogOrder": 40,
    "id": "@regenic/connector-github-copilot",
    "displayName": "GitHub Copilot CLI",
    "engines": {
      "regenic": "1.0"
    },
    "contributes": {
      "drivers": [
        "githubCopilotSessionDriver"
      ],
      "executors": [
        "githubCopilotTaskExecutor"
      ]
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.28",
    "@regenic/connector-contract": "^0.3.0"
  },
  "devDependencies": {
    "@regenic/connector-test-utils": "0.1.0",
    "@regenic/plugin-host": "0.1.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "@regenic/connector-test-utils>@regenic/connector-contract": "^0.3.0"
    }
  }
}
